        "hosted-orgs-invite"
      ],
      "sources": [
        "core/org*.go",
        "apis/orgs*.go",
        "apis/orgs_pages/admin.js",
        "apis/orgs_pages/invite.js",
        "apis/invitations.go",
        "ui/src/orgs/**"
      ]
    },
    {
      "id": "transfers",
      "name": "Member transfers",
      "status": "ready",
