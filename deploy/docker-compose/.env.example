# Copy to .env and edit. Never commit .env.
# Values must not be quoted. Compose reads this file as-is.

# --- Image ---
# Pin a release tag. Find tags at https://github.com/doodlemania2/claviger/releases
CLAVIGER_VERSION=0.1.0

# --- Public name (used by the Caddy profile) ---
# Passkeys are bound to this host name (the "RP ID"). Pick it once and keep it.
CLAVIGER_DOMAIN=auth.example.com

# --- Settings encryption (strongly recommended, set BEFORE first start) ---
# Exactly 32 characters. Generate with: openssl rand -hex 16
# Lose this key and the stored settings (SMTP password, OAuth2 secrets) are unreadable.
# The container refuses to start if the length is not 32.
PB_ENCRYPTION_KEY=

# --- First superuser (created on first start only; later starts leave it alone) ---
# Both must be set. Remove PB_ADMIN_PASSWORD from this file after first start.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# --- Metrics and audit ---
# Setting a token turns on GET /api/metrics (Prometheus, bearer token). Unset = no route.
CLAVIGER_METRICS_TOKEN=
# Days to keep audit events. Unset, empty, 0 or invalid = keep forever.
CLAVIGER_AUDIT_RETENTION_DAYS=

# --- OpenTelemetry log export (optional; unset = off) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# k=v,k=v with URL-encoded values, for example: authorization=Bearer%20TOKEN
OTEL_EXPORTER_OTLP_HEADERS=
# k=v,k=v, for example: service.name=claviger,deployment.environment=prod
OTEL_RESOURCE_ATTRIBUTES=

# --- Single-writer handover (leave alone on Docker Compose) ---
# Compose stops the old container before it starts a new one, so the default is fine.
# PB_HANDOVER_TIMEOUT=60
# PB_HANDOVER_POLL=2

# --- Litestream to S3-compatible storage (optional) ---
# Also uncomment the litestream.s3.yml volume in compose.yaml.
# Setting LITESTREAM_REPLICA_URL is what turns replication on.
LITESTREAM_REPLICA_URL=
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_PATH=claviger
# Leave empty for AWS S3. For MinIO, R2, B2, etc. use their endpoint URL.
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_REGION=us-east-1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
