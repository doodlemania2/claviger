{
  "property": "claviger",
  "audiences": [
    "developer",
    "superuser",
    "staff",
    "member"
  ],
  "features": [
    {
      "id": "installer",
      "name": "First-run installer",
      "status": "ready",
      "summary": "The first start prints a one-time link that creates the first administrator account.",
      "audiences": [
        "developer",
        "superuser"
      ],
      "screens": [
        "admin-login"
      ],
      "sources": [
        "apis/installer.go"
      ]
    },
    {
      "id": "data-api",
      "name": "Collections and data API",
      "status": "ready",
      "summary": "Define collections in the admin UI and get a REST and realtime API with access rules for each one.",
      "audiences": [
        "developer"
      ],
      "screens": [
        "admin-collections",
        "admin-collections-empty",
        "admin-settings-export-collections",
        "admin-settings-import-collections"
      ],
      "sources": [
        "core/collection*.go",
        "core/record*.go",
        "apis/collection*.go",
        "apis/record_crud*.go",
        "apis/realtime.go",
        "apis/batch.go",
        "ui/src/collections/**",
        "ui/src/records/**"
      ]
    },
    {
      "id": "passkeys",
      "name": "Passkeys",
      "status": "ready",
      "summary": "Sign in with a passkey instead of a password, make collections passkey-only, and re-check a passkey before sensitive actions.",
      "audiences": [
        "member",
        "superuser",
        "developer"
      ],
      "headline": true,
      "screens": [
        "hosted-passkeys",
        "admin-auth-confirm-passkey-reset"
      ],
      "sources": [
        "apis/record_auth_with_webauthn*.go",
        "apis/record_auth_passkey_reset_*.go",
        "apis/passkeys_page.go",
        "apis/hosted_assets/passkeys-page.*",
        "core/webauthn_*.go",
        "core/collection_webauthn_validate.go",
        "migrations/*webauthn*.go"
      ]
    },
    {
      "id": "totp",
      "name": "Authenticator apps and backup codes",
      "status": "ready",
      "summary": "Any account can add an authenticator app code and one-time backup codes as a second step at sign-in.",
      "audiences": [
        "member",
        "superuser"
      ],
      "screens": [
        "admin-settings-security",
        "admin-login"
      ],
      "sources": [
        "apis/record_auth_totp.go",
        "core/totp_model.go",
        "core/mfa_*.go",
        "ui/src/settings/security/**"
      ]
    },
    {
      "id": "oidc-provider",
      "name": "OpenID Connect sign-in for your apps",
      "status": "ready",
      "summary": "Your apps send people to Claviger to sign in and get back signed claims, never a password.",
      "audiences": [
        "developer",
        "member"
      ],
      "headline": true,
      "screens": [
        "admin-oidc",
        "hosted-oidc-login",
        "hosted-oidc-consent",
        "hosted-oidc-logged-out",
        "hosted-oidc-error"
      ],
      "sources": [
        "oidc/**",
        "ui/src/oidc/**"
      ]
    },
    {
      "id": "device-sign-in",
      "name": "Device sign-in",
      "status": "ready",
      "summary": "Sign in on a TV, kiosk or command line tool by approving a short code on your phone.",
      "audiences": [
        "member",
        "developer"
      ],
      "screens": [
        "hosted-oidc-device",
        "hosted-oidc-device-approve"
      ],
      "sources": [
        "oidc/device.go"
      ]
    },
    {
      "id": "account-chooser",
      "name": "Several accounts in one browser",
      "status": "ready",
      "summary": "Stay signed in to more than one account in the same browser and pick one without typing.",
      "audiences": [
        "member"
      ],
      "screens": [
        "hosted-oidc-chooser"
      ],
      "sources": [
        "oidc/chooser.go",
        "oidc/sso.go"
      ]
    },
    {
      "id": "api-keys",
      "name": "Scoped API keys",
      "status": "ready",
      "summary": "Give a service a key that can do only what it needs, shown once and stored only as a hash.",
      "audiences": [
        "developer"
      ],
      "screens": [
        "admin-settings-api-keys"
      ],
      "sources": [
        "core/apikey.go",
        "apis/apikey*.go",
        "ui/src/settings/apikeys/**"
      ]
    },
    {
      "id": "webhooks",
      "name": "Signed webhooks",
      "status": "ready",
      "summary": "Tell other systems when records change, with signed deliveries, retries and a delivery log.",
      "audiences": [
        "developer"
      ],
      "headline": true,
      "screens": [
        "admin-webhooks"
      ],
      "sources": [
        "core/webhooks*.go",
        "apis/webhooks.go",
        "ui/src/webhooks/**"
      ]
    },
    {
      "id": "audit-log",
      "name": "Audit log",
      "status": "ready",
      "summary": "Every change is recorded with who made it, when and from where, with secrets redacted.",
      "audiences": [
        "superuser",
        "staff"
      ],
      "screens": [
        "admin-audit"
      ],
      "sources": [
        "core/audit_*.go",
        "apis/audit_*.go",
        "ui/src/audit/**"
      ]
    },
    {
      "id": "user-admin",
      "name": "User administration",
      "status": "ready",
      "summary": "Administrators can ban accounts, end sessions and sign in as a user to help them, and every step is audited.",
      "audiences": [
        "superuser"
      ],
      "sources": [
        "core/ban.go",
        "core/session.go",
        "apis/sessions*.go",
        "apis/record_auth_impersonate.go"
      ]
    },
    {
      "id": "field-encryption",
      "name": "Encrypted fields",
      "status": "ready",
      "summary": "Sensitive fields are stored encrypted, so a stolen database file or backup shows nothing readable.",
      "audiences": [
        "developer",
        "superuser"
      ],
      "headline": true,
      "screens": [
        "admin-settings-encryption-keys"
      ],
      "sources": [
        "core/field_sealed.go",
        "core/field_encrypted_*.go",
        "core/field_keys*.go",
        "apis/field_keys.go",
        "apis/field_encrypted.go",
        "tools/keys/**",
        "ui/src/settings/fieldkeys/**"
      ]
    },
    {
      "id": "encrypted-backups",
      "name": "Encrypted backups",
      "status": "ready",
      "summary": "Backups are encrypted with your key and can be test-restored before the day you need them.",
      "audiences": [
        "superuser"
      ],
      "screens": [
        "admin-settings-backups"
      ],
      "sources": [
        "core/backup*.go",
        "apis/backup*.go",
        "tools/backupenc/**",
        "ui/src/settings/backups/**"
      ]
    },
    {
      "id": "scim",
      "name": "SCIM user provisioning",
      "status": "ready",
      "summary": "Microsoft Entra ID or Okta can create, update and remove users and groups automatically.",
      "audiences": [
        "developer",
        "superuser"
      ],
      "sources": [
        "core/scim*.go",
        "apis/scim*.go"
      ]
    },
    {
      "id": "captcha-rate-limits",
      "name": "Captcha and rate limits",
      "status": "ready",
      "summary": "Slow down password guessing and bot sign-ups with rate limits and an optional captcha.",
      "audiences": [
        "superuser"
      ],
      "screens": [
        "admin-settings-captcha"
      ],
      "sources": [
        "core/settings_captcha.go",
        "tools/captcha/**",
        "apis/captcha*.go",
        "apis/rate_limit_*.go",
        "apis/middlewares_rate_limit.go",
        "ui/src/settings/captcha/**"
      ]
    },
    {
      "id": "sms",
      "name": "Text messages",
      "status": "ready",
      "summary": "Send transactional texts, such as a recovery link, through Twilio or a webhook. Off by default.",
      "audiences": [
        "superuser",
        "member"
      ],
      "screens": [
        "admin-settings-sms"
      ],
      "sources": [
        "core/sms.go",
        "core/settings_sms.go",
        "tools/sms/**",
        "apis/settings_sms.go",
        "ui/src/settings/sms/**"
      ]
    },
    {
      "id": "telemetry",
      "name": "OpenTelemetry and metrics",
      "status": "ready",
      "summary": "Send logs, traces and metrics to your monitoring, or read Prometheus metrics behind a token.",
      "audiences": [
        "developer"
      ],
      "sources": [
        "core/telemetry.go",
        "core/logger_otel.go",
        "tools/telemetry/**",
        "apis/middlewares_telemetry.go"
      ]
    },
    {
      "id": "postgres",
      "name": "PostgreSQL support",
      "status": "ready",
      "summary": "Run on PostgreSQL instead of the built-in SQLite database when you need to.",
      "audiences": [
        "developer"
      ],
      "sources": [
        "tools/dialect/**",
        "core/*_dialect.go",
        "apis/*_dialect.go",
        "scripts/pgembedded/**"
      ]
    },
    {
      "id": "multi-replica",
      "name": "Several servers",
      "status": "ready",
      "summary": "On PostgreSQL, run more than one Claviger server behind a load balancer.",
      "audiences": [
        "developer"
      ],
      "sources": [
        "core/multireplica.go",
        "apis/multireplica_state.go",
        "apis/realtime_replica.go",
        "tools/replica/**"
      ]
    },
    {
      "id": "deploy-templates",
      "name": "Deploy templates",
      "status": "ready",
      "summary": "Ready-made setups for Docker Compose, Fly.io, Kubernetes and Azure Container Apps.",
      "audiences": [
        "developer"
      ],
      "sources": [
        "deploy/**",
        "Dockerfile",
        "docker-compose.yml"
      ]
    },
    {
      "id": "rolling-deploy-handover",
      "name": "Safe rolling deploys on SQLite",
      "status": "ready",
      "summary": "During a rolling deploy the old container hands the database to the new one, so the two never write at once.",
      "audiences": [
        "developer"
      ],
      "sources": [
        "entrypoint.sh",
        "scripts/test_entrypoint_handover.sh"
      ]
    },
    {
      "id": "organizations",
      "name": "Organizations",
      "status": "ready",
      "summary": "Model a diocese, its parishes and their groups, with members, roles, tags and invitations.",
